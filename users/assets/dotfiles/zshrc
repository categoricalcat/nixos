#! /usr/bin/env zsh

# Imperative shell glue; the structured config (aliases, history,
# autosuggestion, options) lives in users/home/shell.nix.

echo "伊的zsh配置"
echo "[uid] $(id -u)"
echo "[iam] $(whoami)"
echo "[pwd] $(pwd)"
echo "[host] $(hostname)"

# Dumb terminals (TRAMP, emacs M-x shell): plain prompt, no zle, skip the rest.
if [[ "$TERM" == "dumb" ]]; then
	unsetopt zle
	unsetopt prompt_cr
	unsetopt prompt_subst
	PS1='...$ '
	return
fi

zstyle ':completion:*' completer _complete _ignored
zstyle ':completion:*' menu select

bindkey '^ ' autosuggest-accept
bindkey '^]' autosuggest-execute

echo "hello, gently, from self :3"

if [[ -n "${SSH_CONNECTION:-}" ]]; then
	fastfetch
fi
