@@ -0,0 +1,92 @@
+{ inputs, ... }:
+{
+  perSystem =
+    { pkgs, ... }:
+    let
+      unstablePkgs = import ../../modules/nixpkgs-unstable.nix { inherit inputs pkgs; };
+      addresses = import ../../modules/addresses.nix;
+      ai = import ../../modules/services/ai/models.nix;
+
+      graphifyPort = 11434;
+      graphifyPath = "v1";
+      graphifyDefaultModel = "mistral-nemo:12b";
+
+      libraryPath = pkgs.lib.makeLibraryPath [ pkgs.stdenv.cc.cc.lib ];
+
+      modelNames = builtins.attrNames ai.local.models;
+
+      graphifyModelsFile = pkgs.writeText "graphify-models.txt" (
+        pkgs.lib.concatStringsSep "\n" modelNames + "\n"
+      );
+      graphifyLocalBaseUrl = "http://localhost:${toString graphifyPort}/${graphifyPath}";
+      graphifyRemoteBaseUrl = "http://${addresses.hosts.yifuwuqi.network.tailscale.ipv4.host}:${toString graphifyPort}/${graphifyPath}";
+      graphifyScript = pkgs.replaceVars ./graphify-nix.sh {
+        inherit
+          graphifyDefaultModel
+          graphifyModelsFile
+          graphifyRemoteBaseUrl
+          libraryPath
+          ;
+      };
+
+      graphifyNix = pkgs.writeShellApplication {
+        name = "graphify-nix";
+        runtimeInputs = [
+          pkgs.coreutils
+          pkgs.fd
+          pkgs.gnused
+          pkgs.uv
+        ];
+        text = builtins.readFile graphifyScript;
+      };
+    in
+    {
+      devShells.ai = pkgs.mkShell {
+        packages = [
+          graphifyNix
+          unstablePkgs.opencode
+          pkgs.fd
+          pkgs.jq
+          pkgs.ripgrep
+          pkgs.uv
+        ];
+
+        shellHook = ''
+          export LD_LIBRARY_PATH="${libraryPath}''${LD_LIBRARY_PATH:+:''${LD_LIBRARY_PATH}}"
+          if [ "$(${pkgs.nettools}/bin/hostname)" = "${addresses.hosts.yifuwuqi.hostName}" ]; then
+            graphify_base_url="${graphifyLocalBaseUrl}"
+          else
+            graphify_base_url="${graphifyRemoteBaseUrl}"
+          fi
+          export OPENAI_BASE_URL="''${OPENAI_BASE_URL:-$graphify_base_url}"
+          export OPENAI_API_KEY="local"
+          export GRAPHIFY_BACKEND="openai"
+          export GRAPHIFY_DEFAULT_MODEL="${graphifyDefaultModel}"
+          export GRAPHIFY_MODEL="''${GRAPHIFY_MODEL:-$GRAPHIFY_DEFAULT_MODEL}"
+          export GRAPHIFY_TOKEN_BUDGET="''${GRAPHIFY_TOKEN_BUDGET:-2000}"
+          export GRAPHIFY_MAX_CONCURRENCY="''${GRAPHIFY_MAX_CONCURRENCY:-1}"
+          export GRAPHIFY_API_TIMEOUT="''${GRAPHIFY_API_TIMEOUT:-900}"
+          export GRAPHIFY_MAX_OUTPUT_TOKENS="''${GRAPHIFY_MAX_OUTPUT_TOKENS:-5120}"
+
+          echo "AI shell: graphify-nix + opencode"
+          echo "  backend: derived llama-swap OpenAI API"
+          echo "  model: configured default; run graphify-nix --list-models"
+          echo "  graphify-nix"
+          echo "  graphify-nix --list-models"
+          echo "  graphify-nix --prepare-only"
+          echo "  opencode"
+        '';
+      };
+
+      packages.ai = pkgs.mkShell {
+        packages = [
+          graphifyNix
+          unstablePkgs.opencode
+          pkgs.fd
+          pkgs.jq
+          pkgs.ripgrep
+          pkgs.uv
+        ];
+      };
+    };
+}
diff --git a/nix/devshells/graphify-nix.sh b/nix/devshells/graphify-nix.sh
new file mode 100644
index 0000000..636fba6
--- /dev/null
+++ b/nix/devshells/graphify-nix.sh
@@ -0,0 +1,128 @@
+usage() {
+  cat <<'EOF'
+Usage: graphify-nix [--prepare-only] [--model MODEL] [--list-models] [graphify extract args...]
+
+Build a Graphify corpus from this repo's .nix files and run extraction through
+the derived llama-swap OpenAI-compatible endpoint.
+
+Options:
+  --prepare-only  build the Nix-only corpus and stop
+  --list-models   print raw model names from modules/services/ai/models.nix
+  --model MODEL   use a model directly
+EOF
+}
+
+list_models() {
+  cat "@graphifyModelsFile@"
+}
+
+prepare_only=0
+selected_model="${GRAPHIFY_MODEL:-@graphifyDefaultModel@}"
+graphify_args=()
+
+while (($#)); do
+  case "$1" in
+    --prepare-only)
+      prepare_only=1
+      ;;
+    --list-models)
+      list_models
+      exit 0
+      ;;
+    --model | -m)
+      if [ "$#" -lt 2 ]; then
+        echo "graphify-nix: --model requires a model name" >&2
+        exit 2
+      fi
+      selected_model="$2"
+      shift
+      ;;
+    --model=*)
+      selected_model="${1#--model=}"
+      ;;
+    -h | --help)
+      usage
+      exit 0
+      ;;
+    --)
+      shift
+      graphify_args+=("$@")
+      break
+      ;;
+    *)
+      graphify_args+=("$1")
+      ;;
+  esac
+  shift
+done
+
+if ! grep -Fx -- "$selected_model" "@graphifyModelsFile@" >/dev/null; then
+  echo "graphify-nix: unknown model '$selected_model'" >&2
+  echo "Available models:" >&2
+  list_models >&2
+  exit 2
+fi
+
+corpus=".graphify-nix-corpus"
+rm -rf "$corpus"
+mkdir -p "$corpus"
+
+count=0
+while IFS= read -r -d "" file; do
+  out="$corpus/$file.md"
+  mkdir -p "$(dirname "$out")"
+  {
+    printf '# %s\n\n' "$file"
+    printf 'Source: %s\n\n' "$file"
+    printf '```nix\n'
+    cat "$file"
+    printf '\n```\n'
+  } > "$out"
+  count=$((count + 1))
+done < <(
+  fd -0 --extension nix --type file \
+    --exclude .git \
+    --exclude .cursor \
+    --exclude .graphify \
+    --exclude graphify-out \
+    --exclude secrets \
+    . .
+)
+
+echo "Prepared $count Nix files in $corpus"
+
+if [ "$count" -eq 0 ]; then
+  echo "No .nix files found." >&2
+  exit 1
+fi
+
+if [ "$prepare_only" -eq 1 ]; then
+  exit 0
+fi
+
+export LD_LIBRARY_PATH="@libraryPath@${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
+export GRAPHIFY_MAX_OUTPUT_TOKENS="${GRAPHIFY_MAX_OUTPUT_TOKENS:-1024}"
+
+runner="$(mktemp)"
+trap 'rm -f "$runner"' EXIT
+cat > "$runner" <<'PY'
+import os
+from graphify import llm
+from graphify.__main__ import main
+
+llm.BACKENDS["openai"]["base_url"] = os.environ.get(
+    "OPENAI_BASE_URL",
+    "@graphifyRemoteBaseUrl@",
+)
+main()
+PY
+
+exec uv run --with "graphifyy[openai]" python "$runner" extract "$corpus" \
+  --backend "${GRAPHIFY_BACKEND:-openai}" \
+  --model "$selected_model" \
+  --token-budget "${GRAPHIFY_TOKEN_BUDGET:-2000}" \
+  --max-concurrency "${GRAPHIFY_MAX_CONCURRENCY:-1}" \
+  --api-timeout "${GRAPHIFY_API_TIMEOUT:-900}" \
+  --no-viz \
+  --out . \
+  "${graphify_args[@]}"
