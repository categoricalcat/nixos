+void Editor::sync_win32_position(int16_t x, int16_t y) {
+    const int win32_x = x + GetSystemMetrics(SM_XVIRTUALSCREEN);
+    const int win32_y = y + GetSystemMetrics(SM_YVIRTUALSCREEN);
+
+    if (last_win32_position_ && (*last_win32_position_)[0] == win32_x &&
+        (*last_win32_position_)[1] == win32_y) {
+        return;
+    }
+    last_win32_position_ = {{win32_x, win32_y}};
+
+    logger_.log_editor_trace([&]() {
+        return "DEBUG: Syncing win32 window position to (" +
+               std::to_string(win32_x) + ", " + std::to_string(win32_y) +
+               ") from X11 root position (" + std::to_string(x) + ", " +
+               std::to_string(y) + ")";
+    });
+
+    SetWindowPos(win32_window_.handle_, nullptr, win32_x, win32_y, 0, 0,
+                 SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE |
+                     SWP_NOSENDCHANGING | SWP_DEFERERASE);
+}
