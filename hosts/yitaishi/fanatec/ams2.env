# Fanatec CSL DD profile for Automobilista 2.
# Edit values below, then apply with: sudo systemctl restart fanatec-tuning
#
# Matching AMS2 in-game FFB baseline:
# - Gain: 65
# - Low Force Boost: 0
# - FX: 0
# - Menu Spring Strength: 0
#
# Under hid-fanatecff, SEN Auto for CSL DD maps to 2530.
SEN=2530

FF=100
FFS=1
NDP=25
NFR=0
NIN=0
INT=4
FEI=100
FOR=100
SPR=100
DPR=100
SHO=100

# User preference values:
# BLI=0
