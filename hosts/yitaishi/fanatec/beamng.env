# Fanatec CSL DD profile for BeamNG.drive.
# Edit values below, then apply with: sudo systemctl restart fanatec-tuning
#
# Matching BeamNG in-game FFB baseline:
# - FFB Strength: 250
# - FFB Smoothing: 60
# - Side Acceleration: 5
# - Reduce Strength While Parked: ON
# - FFB Update Rate Limit: 1000 Hz

SEN=900
FF=100
FFS=1
NDP=35
NFR=3
NIN=0
INT=4
FEI=100
FOR=100
SPR=100
DPR=100
SHO=100
BLI=0
