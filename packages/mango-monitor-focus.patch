+void toggleoverview(const Arg *arg) {
+	Monitor *m = NULL;
+	Monitor *focus_mon = selmon; /* selmon 会被 focusclient 改写，先固定 */
+	bool any_overview = false;
+
+	if (!selmon || grabc)
+		return;
+
+	wl_list_for_each(m, &mons, link) {
+		if (!m->wlr_output || !m->wlr_output->enabled)
+			continue;
+		if (m->isoverview) {
+			any_overview = true;
+			break;
+		}
+	}
+
+	wl_list_for_each(m, &mons, link) {
+		if (!m->wlr_output || !m->wlr_output->enabled)
+			continue;
+		set_overview_mon(m, arg, !any_overview, m == focus_mon, focus_mon);
+	}
+}
