 	}
 }
 
-void toggle_overview(const Arg *arg) {
+static void toggle_overview_one(const Arg *arg) {
 	Client *c = NULL;
 	if (!server.selected_monitor || server.grab_client)
 		return;
@@ -2327,6 +2327,37 @@ void toggle_overview(const Arg *arg) {
 	return;
 }
 
+void toggle_overview(const Arg *arg) {
+	Monitor *m = NULL, *focus = server.selected_monitor;
+	Client *sel;
+	bool enter;
+
+	if (!focus || server.grab_client)
+		return;
+
+	sel = focus->sel;
+	enter = !focus->isoverview;
+
+	toggle_overview_one(arg);
+
+	wl_list_for_each(m, &server.monitors, link) {
+		if (m == focus || !m->wlr_output || !m->wlr_output->enabled)
+			continue;
+		if ((bool)m->isoverview == enter)
+			continue;
+		/* toggle_overview_one() and client_focus() work off selected_monitor,
+		 * so drive it per monitor and restore it afterwards. */
+		server.selected_monitor = m;
+		toggle_overview_one(&(Arg){0});
+	}
+
+	server.selected_monitor = focus;
+	if (!enter && sel && VISIBLEON(sel, focus))
+		client_focus(sel, 1);
+	else
+		client_focus(client_focus_top(focus), 1);
+}
+
 void toggle_jump(const Arg *arg) {
