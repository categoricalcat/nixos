diff --git a/src/overview/overview_all.c b/src/overview/overview_all.c
new file mode 100644
index 0000000..5eb0325
--- /dev/null
+++ b/src/overview/overview_all.c
@@ -0,0 +1,164 @@
+#include "mango/overview/overview_all.h"
+#include "mango/common/server.h"
+#include "mango/ext-protocol/ext-workspace.h"
+#include "mango/input/pointer.h"
+#include "mango/layout/arrange.h"
+#include "mango/layout/overview.h"
+#include "mango/manage/client.h"
+#include "mango/manage/monitor.h"
+#include "mango/overview/overview.h"
+#include <wlr/types/wlr_compositor.h>
+#include <wlr/types/wlr_cursor.h>
+#include <wlr/types/wlr_output.h>
+#include <wlr/types/wlr_seat.h>
+#include <wlr/types/wlr_xcursor_manager.h>
+
+/* Defined in src/dispatch/bind.c, which exports no header for it. */
+void fix_mon_tagset_from_overview(Monitor *m);
+
+/* Per-monitor half of toggle_overview_all: enters or leaves overview on mon
+ * while focus_mon keeps seat focus. changefocus is only set for focus_mon so
+ * the other monitors are rearranged without stealing focus. */
+static void set_overview_mon(Monitor *mon, const Arg *arg, bool enter,
+							 bool changefocus, Monitor *focus_mon) {
+	Client *c = NULL;
+	if (!mon || !focus_mon || (bool)mon->isoverview == enter)
+		return;
+
+	Client *sel = (arg->tc && arg->tc->mon == mon) ? arg->tc : mon->sel;
+
+	uint32_t target = 0;
+	uint32_t visible_client_number = 0;
+
+	if (!enter) {
+		mon->ov_tab_layout = 0;
+		if (mon->is_jump_mode)
+			finish_jump_mode(mon);
+	}
+
+	if (enter) {
+		wl_list_for_each(c, &server.clients,
+						 link) if (c && c->mon == mon &&
+								   !client_is_unmanaged(c) &&
+								   !client_is_x11_popup(c) && !c->isminimized &&
+								   !c->isunglobal && !(c->tags & TAG0_MASK)) {
+			visible_client_number++;
+		}
+		/* An empty monitor stays out of overview, keeping the global state
+		 * reversible. */
+		if (visible_client_number == 0) {
+			mon->ov_tab_layout = 0;
+			return;
+		}
+
+		if (mon != focus_mon) {
+			mon->ov_normal_mode =
+				focus_mon->is_jump_mode ? 1 : focus_mon->ov_normal_mode;
+			mon->ov_tab_layout = focus_mon->ov_tab_layout;
+		}
+
+		mon->isoverview = 1;
+		mon->ovbk_current_tagset = mon->tagset[mon->seltags];
+		mon->ovbk_prev_tagset = mon->tagset[mon->seltags ^ 1];
+		target = ~0 & TAGMASK;
+	} else {
+		mon->isoverview = 0;
+		if (sel && (sel->tags & TAGMASK) != 0) {
+			target = get_tags_first_tag(sel->tags);
+		} else {
+			target =
+				mon->ovbk_current_tagset
+					? (mon->ovbk_current_tagset & TAGMASK)
+					: (mon->pertag->prevtag ? (1 << (mon->pertag->prevtag - 1))
+											: 1);
+			if (!target)
+				target = 1;
+		}
+	}
+
+	if (enter) {
+		if (mon == focus_mon) {
+			wlr_seat_pointer_clear_focus(server.seat);
+
+			if (server.cursor_hidden) {
+				pointer_cursor_activity();
+			} else {
+				wlr_cursor_set_xcursor(server.cursor, server.cursor_manager,
+									   "default");
+			}
+		}
+
+		wl_list_for_each(c, &server.clients, link) {
+			if (c && c->mon == mon && !client_is_unmanaged(c) &&
+				!client_is_x11_popup(c) && !c->isunglobal && !c->isminimized &&
+				!(c->tags & TAG0_MASK) && client_surface(c)->mapped) {
+				c->animation.overining = true;
+				if (!mon->is_jump_mode && !mon->ov_normal_mode)
+					/* Tab layout: skip view arrangement first; set it when the
+					 * unified rearrange runs after entering. */
+					c->animation.overview_enter_anim_set = true;
+				else
+					/* Other modes: set zoom during view arrangement. */
+					c->animation.overview_enter_anim_set = false;
+				overview_backup(c);
+			}
+		}
+	} else {
+		mon->ov_normal_mode = 0; /* Clears hot-area normal mode when exiting. */
+
+		mon->tagset[mon->seltags] = target;
+		wl_list_for_each(c, &server.clients, link) {
+			if (c && c->mon == mon && !c->iskilling &&
+				!client_is_unmanaged(c) && !c->isunglobal && !c->isminimized &&
+				!client_is_x11_popup(c) && client_surface(c)->mapped &&
+				!(c->tags & TAG0_MASK)) {
+				overview_restore(c, &(Arg){.ui = target});
+			}
+		}
+	}
+
+	client_view_on_monitor(&(Arg){.ui = target}, false, mon, changefocus);
+
+	/* Tab layout: rearrange after entering. */
+	if (mon->isoverview && !mon->is_jump_mode && !mon->ov_normal_mode) {
+		Client *cc = NULL;
+		wl_list_for_each(cc, &server.clients, link) {
+			if (cc && cc->mon == mon && !client_is_unmanaged(cc) &&
+				!client_is_x11_popup(cc) && !(cc->tags & TAG0_MASK))
+				cc->animation.overview_enter_anim_set = false;
+		}
+		arrange(mon, true, false);
+	}
+
+	fix_mon_tagset_from_overview(mon);
+	refresh_monitors_workspaces_status(mon);
+
+	if (!mon->isoverview && sel && (sel->tags & target) && changefocus) {
+		client_focus(sel, 1);
+	}
+}
+
+void toggle_overview_all(const Arg *arg) {
+	Monitor *m = NULL;
+	/* client_focus() reassigns selected_monitor, so pin it up front. */
+	Monitor *focus_mon = server.selected_monitor;
+	bool any_overview = false;
+
+	if (!focus_mon || server.grab_client)
+		return;
+
+	wl_list_for_each(m, &server.monitors, link) {
+		if (!m->wlr_output || !m->wlr_output->enabled)
+			continue;
+		if (m->isoverview) {
+			any_overview = true;
+			break;
+		}
+	}
+
+	wl_list_for_each(m, &server.monitors, link) {
+		if (!m->wlr_output || !m->wlr_output->enabled)
+			continue;
+		set_overview_mon(m, arg, !any_overview, m == focus_mon, focus_mon);
+	}
+}
